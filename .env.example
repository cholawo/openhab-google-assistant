# Assistant server (npm start)
OH_HOST=<YOUR-CLOUD-HOST>
OH_PORT=443
OH_PATH=/rest/items/
OH_SERVER_PORT=3000
OH_LOCAL_FULFILLMENT=false

# Local server (npm run start:local)
LOCAL_PORT=3002
LOCAL_OPENHAB_URL=http://127.0.0.1:8080
# LOCAL_OPENHAB_USERPASS=user:password
LOCAL_MDNS_NAME=openhab-google
